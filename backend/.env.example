# Gemini API Key (Get one from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Optional fallback, get one from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (Optional fallback, get one from https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here

# JWT Secret Key
JWT_SECRET_KEY=your_secret_key_here_change_this

PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins — comma-separated list of allowed frontend origins.
# In production, set this to the actual deployed frontend URL, e.g.:
#   ALLOWED_ORIGINS=https://quickmind-frontend.onrender.com
# Multiple origins: ALLOWED_ORIGINS=https://app1.onrender.com,https://app2.onrender.com
# Defaults to http://localhost:8501 (local Streamlit dev) if not set.
ALLOWED_ORIGINS=http://localhost:8501
